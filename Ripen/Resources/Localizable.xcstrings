{
  "sourceLanguage": "en",
  "strings": {
    "Focus history could not be loaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus history could not be loaded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入專注紀錄。"
          }
        }
      }
    },
    "Your existing data is kept. You can keep using the timer and retry saving.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your existing data is kept. You can keep using the timer and retry saving."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "既有資料已保留。你可以繼續計時，並重試儲存。"
          }
        }
      }
    },
    "Unsaved focuses: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsaved focuses: %lld"
